PS -> CODE", 23, BOLD)
        route.to_edge(DOWN, buff=0.36)

        layout = VGroup(scenario, question, cards, links)
        self.assert_content_safe(layout, "scene_07 project thinking")
        self.assert_within_frame(route, "scene_07 route", margin=0.20)

        self.play(FadeIn(scenario, shift=UP*0.08), FadeIn(question), run_time=RUN_NORMAL)
        self.wait(PAUSE_EXPLAIN)
        self.play(LaggedStart(*[FadeIn(card, shift=UP*0.10) for card in cards], lag_ratio=0.15), run_time=RUN_SLOW)
        self.wait(PAUSE_READ)
        for link in links:
            self.play(GrowArrow(link[0]), FadeIn(link[1]), run_time=RUN_NORMAL)
        self.wait(PAUSE_EXPLAIN)
        self.play(FadeIn(route, shift=UP*0.08), run_time=RUN_NORMAL)
        self.wait(PAUSE_FINAL)
        self.clear_stage()

    def set_header(self, number: int, title: str, subtitle: str) -> None:
        """Use clean fades between sections instead of glyph morphing.

        V9/V10 QA showed that ReplacementTransform can briefly distort long
        subtitles during a section change.  Fade the persistent header lane
        out, rebuild it using the consolidated JP layout, then fade it in.
        """
        had_old = self.header_group is not None or self.subtitle_group is not None
        if had_old:
            old_items = [
                item for item in (self.header_group, self.subtitle_group)
                if item is not None
            ]
            if old_items:
                self.play(*[FadeOut(item) for item in old_items], run_time=RUN_QUICK * 0.45)
                self.remove(*old_items)
            self.header_group = None
            self.subtitle_group = None

        super().set_header(number, title, subtitle)

        if had_old:
            self.header_group.set_opacity(0)
            self.subtitle_group.set_opacity(0)
            self.play(
                self.header_group.animate.set_opacity(1),
                self.subtitle_group.animate.set_opacity(1),
                run_time=RUN_QUICK * 0.55,
            )


