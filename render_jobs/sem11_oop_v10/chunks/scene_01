urn parts.scale(scale)

    def boat(self, scale: float = 1.0, label: str | None = None) -> VGroup:
        hull = Polygon(LEFT*0.90, RIGHT*0.90, RIGHT*0.62+DOWN*0.32, LEFT*0.62+DOWN*0.32,
                       stroke_color=BLACK_LINE, stroke_width=2.0, fill_color=WHITE, fill_opacity=1)
        mast = Line(ORIGIN+UP*0.05, ORIGIN+UP*1.15, color=BLACK_LINE, stroke_width=1.7)
        sail = Polygon(ORIGIN+UP*1.10, ORIGIN+UP*0.25, RIGHT*0.70+UP*0.25,
                       stroke_color=BLACK_LINE, stroke_width=1.7, fill_color=VERY_LIGHT_GRAY, fill_opacity=1)
        waves = VGroup(*[
            Arc(radius=0.27, start_angle=0, angle=PI, stroke_color=MID_GRAY, stroke_width=1.4)
            for _ in range(4)
        ]).arrange(RIGHT, buff=-0.08).next_to(hull, DOWN, buff=0.05)
        parts = VGroup(hull, mast, sail, waves)
        if label:
            parts = VGroup(parts, self.text(label, 18, BOLD).next_to(parts, DOWN, buff=0.15))
        return parts.scale(scale)

    def arrow_with_label(self, start: np.ndarray, end: np.ndarray, label: str, label_shift=UP*0.18) -> VGroup:
        arrow = Arrow(start, end, buff=0.12, color=BLACK_LINE, stroke_width=2.0, max_tip_length_to_length_ratio=0.14)
        text = self.text(label, 16, MEDIUM).move_to((start + end)/2 + label_shift)
        return VGroup(arrow, text)

