    # 05 — polymorphism
    # ------------------------------------------------------------------
    def scene_polymorphism(self) -> None:
        self.set_header(
            5,
            "POLYMORPHISM: ONE MESSAGE, DIFFERENT MOTION",
            "The caller sends the same move() message; each object decides how that behavior is implemented.",
        )

        message_label = self.text("ONE INTERFACE", 18, BOLD)
        message = self.pill("move()", 2.00, 0.58, 23)
        command = VGroup(message_label, message).arrange(DOWN, buff=0.14).move_to(UP*1.95)

        robot = self.robot(scale=0.72, label="Robot").move_to(LEFT*4.45 + DOWN*0.35)
        drone = self.drone(scale=1.00, label="Drone").move_to(DOWN*0.35)
        boat = self.boat(scale=0.88, label="Boat").move_to(RIGHT*4.45 + DOWN*0.30)
        objects = VGroup(robot, drone, boat)
        implementations = VGroup(self.pill("roll", 1.20), self.pill("fly", 1.20), self.pill("sail", 1.20))
        for tag, obj in zip(implementations, objects):
            tag.next_to(obj, DOWN, buff=0.22)

        arrows = VGroup(*[
            Arrow(message.get_bottom(), obj.get_top(), buff=0.18, color=LIGHT_GRAY, stroke_width=1.8)
            for obj in objects
        ])
        note = self.text("Same call. Different implementation. The caller stays simple.", 24, BOLD).to_edge(DOWN, buff=0.34)

        layout = VGroup(command, objects, implementations, arrows)
        self.assert_content_safe(layout, "scene_05 polymorphism")
        self.assert_within_frame(note, "scene_05 note", margin=0.20)

        self.play(FadeIn(command, shift=DOWN*0.08), run_time=RUN_NORMAL)
        self.play(LaggedStart(*[FadeIn(o, shift=UP*0.10) for o in objects], lag_ratio=0.14), run_time=RUN_SLOW)
        self.play(LaggedStart(*[GrowArrow(a) for a in arrows], lag_ratio=0.12), run_time=RUN_NORMAL)
        self.wait(PAUSE_EXPLAIN)

        # Different physical responses, all remaining in their local safe zones.
        self.play(robot.animate.shift(RIGHT*0.60), FadeIn(implementations[0]), run_time=RUN_NORMAL)
        self.play(drone.animate.shift(UP*0.42), FadeIn(implementations[1]), run_time=RUN_NORMAL)
        self.play(boat.animate.shift(RIGHT*0.42), FadeIn(implementations[2]), run_time=RUN_NORMAL)
        self.play(FadeIn(note, shift=UP*0.08), run_time=RUN_NORMAL)
        self.wait(PAUSE_WORK)
        self.clear_stage()

